{
  "name": "linkedin-import",
  "version": "1.2.0",
  "private": true,
  "description": "Dgmos Lead Capture — Chrome MV3 extension + host-mapped sidecar API",
  "scripts": {
    "apply-config": "node scripts/apply-config.mjs",
    "test": "npm run apply-config && npm --prefix extension test && cd api && go test ./...",
    "test:extension": "npm --prefix extension test",
    "test:api": "cd api && go test ./...",
    "dev": "docker compose up --build",
    "demo:up": "docker compose -f examples/host-demo/docker-compose.yml up --build -d",
    "demo:down": "docker compose -f examples/host-demo/docker-compose.yml down",
    "smoke": "python3 scripts/smoke.py",
    "demo:smoke": "npm run demo:up && python3 scripts/smoke.py --wait 90",
    "package": "bash scripts/package-extension.sh",
    "build:api": "cd api && go build -o ../dist/api ./cmd"
  }
}
