{
  "manifest_version": 3,
  "name": "Dgmos Lead Capture",
  "description": "Capture profiles and save them to Dgmos.",
  "version": "2.0.0",
  "key": "",
  "minimum_chrome_version": "116",
  "homepage_url": "https://dgmos.com",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "alarms",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://sandbox.dgmos.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Dgmos Lead Capture",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon48.png"
      ],
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ]
    }
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": [
        "config.js",
        "api.js",
        "providers/registry.js",
        "providers/linkedin/core.js",
        "providers/linkedin/collector.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
