{
  "manifest_version": 3,
  "name": "Dgmos LinkedIn Import",
  "description": "Import LinkedIn connections, search results, and CSV exports into Dgmos.",
  "version": "1.2.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "alarms",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "http://localhost:8088/*",
    "http://127.0.0.1:8088/*"
  ],
  "action": {
    "default_title": "Dgmos LinkedIn Import",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": [
        "config.js",
        "providers/registry.js",
        "providers/linkedin/core.js",
        "providers/linkedin/collector.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
